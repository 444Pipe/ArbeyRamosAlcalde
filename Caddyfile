# Servidor del sitio de campaña.
# Railway asigna el puerto por la variable PORT; en local cae a 8080.

{
	admin off
	persist_config off
}

:{$PORT:8080} {
	# SITE_ROOT permite previsualizar en local: SITE_ROOT=. caddy run
	root * {$SITE_ROOT:/srv}
	encode zstd gzip

	# --- URLs limpias ---
	# La dirección pública es sin ".html": /perfil, /gestion, /voz...
	# Los enlaces viejos con extensión redirigen de forma permanente
	# para que lo ya compartido siga funcionando y el buscador entienda
	# que es la misma página.
	@indice path /index.html
	redir @indice / permanent

	@extension path_regexp limpia ^/(.+)\.html$
	redir @extension /{re.limpia.1} permanent

	# Páginas que cambiaron de nombre en su momento.
	redir /candidato /perfil permanent
	redir /propuestas /gestion permanent

	# /perfil se sirve desde el archivo perfil.html.
	try_files {path} {path}.html

	# --- Cabeceras de seguridad ---
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# El mapa ciudadano pide ubicación y la cámara para la foto del reporte.
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}

	# --- Caché ---
	# Ningún archivo lleva hash en el nombre, así que una caché larga dejaría
	# a la gente con una versión vieja del sitio sin forma de saberlo.
	# "no-cache" no significa no guardar: guarda y revalida, y una respuesta
	# 304 pesa unos pocos bytes.

	# Las imágenes sí se pueden guardar: cambian poco y pesan.
	@medios path *.png *.jpg *.jpeg *.webp *.svg *.ico *.woff2
	header @medios Cache-Control "public, max-age=86400"

	# Todo lo demás se revalida siempre: las páginas (que ahora se piden
	# sin ".html"), el código, el service worker y el manifest.
	# La "?" fija la cabecera solo donde no la puso la regla anterior.
	header ?Cache-Control "no-cache"

	file_server

	# Página propia para direcciones que no existen, en vez de la de Caddy.
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
